NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name if you still use older Supabase docs:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bunny Stream (video hosting + multi-audio HLS)
# API key: Bunny dashboard > Stream > your library > API
BUNNY_STREAM_API_KEY=
# Numeric library id of your Bunny Stream video library
BUNNY_STREAM_LIBRARY_ID=
# CDN hostname of the pull zone tied to the library, e.g. vz-xxxxxxxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Token Authentication signing key: Bunny > Stream > your library > Security.
# Without it the app emits UNSIGNED urls, which Bunny rejects once Token
# Authentication is enabled. Required in production.
BUNNY_STREAM_TOKEN_AUTH_KEY=

# ── Acceso anticipado (la puerta con contrasena + cuenta regresiva) ──────────
# La LANDING se ve entera y publica. Lo que queda detras de la contrasena es solo
# la ENTRADA al producto: /sign-in, /registro, /dashboard y /admin.
#
# La lista es de lo que se cierra, no de lo que se deja pasar (ver
# src/lib/acceso-anticipado.ts). Asi /api no puede quedar cerrado por descuido:
# si lo estuviera, Stripe recibiria HTML en vez de procesar pagos y el cron de
# keepalive dejaria de correr, y ninguna de las dos cosas avisa.
#
# La contrasena que se reparte. Si no se define, vale "brunedance2026".
ACCESO_ANTICIPADO_PASSWORD=
# Poner en 0 / false / no PARA ABRIR EL SITIO AL PUBLICO.
# Si no se define, la puerta esta PUESTA: abrir es una decision explicita, no
# algo que pasa porque una variable no llego al deploy.
ACCESO_ANTICIPADO_ACTIVO=
# Fecha que muestra el contador, con huso horario. Por defecto:
# 2026-11-15T00:00:00+01:00 (Barcelona). Es SOLO para mostrar: que el contador
# llegue a cero NO abre el sitio.
ACCESO_ANTICIPADO_FECHA=
