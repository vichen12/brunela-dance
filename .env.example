NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name if you still use older Supabase docs:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bunny Stream (video hosting + multi-audio HLS)
# API key: Bunny dashboard > Stream > your library > API
BUNNY_STREAM_API_KEY=
# Numeric library id of your Bunny Stream video library
BUNNY_STREAM_LIBRARY_ID=
# CDN hostname of the pull zone tied to the library, e.g. vz-xxxxxxxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Token Authentication signing key: Bunny > Stream > your library > Security.
# Without it the app emits UNSIGNED urls, which Bunny rejects once Token
# Authentication is enabled. Required in production.
BUNNY_STREAM_TOKEN_AUTH_KEY=
